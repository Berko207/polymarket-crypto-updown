{
  "name": "polymarket-crypto-updown",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/dev.ts",
    "dev:vite": "vite",
    "dev:vercel": "vercel dev",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bot:record": "BOT_ALLOW_LIVE=0 tsx bot/index.ts record",
    "bot:paper": "BOT_ALLOW_LIVE=0 tsx bot/index.ts paper",
    "bot:swing": "BOT_STRATEGY=swing BOT_ALLOW_LIVE=0 tsx bot/index.ts paper",
    "bot:certainty": "BOT_STRATEGY=certainty BOT_MAX_CONCURRENT=12 BOT_ALLOW_LIVE=0 tsx bot/index.ts paper",
    "bot:certainty:live": "BOT_STRATEGY=certainty BOT_ALLOW_LIVE=1 BOT_STAKE_USD=1 BOT_MAX_CONCURRENT=4 BOT_CERTAINTY_MAX_COINS=2 BOT_CERTAINTY_MAX_ASK=0.92 tsx bot/index.ts live --allow-live",
    "bot:swing:armed": "BOT_STRATEGY=swing BOT_ALLOW_LIVE=1 tsx bot/index.ts paper --allow-live",
    "bot:dry": "BOT_ALLOW_LIVE=0 tsx bot/index.ts dry",
    "bot:live": "BOT_ALLOW_LIVE=1 tsx bot/index.ts live --allow-live",
    "bot:report": "tsx bot/report.ts",
    "bot:backtest": "tsx bot/backtest.ts",
    "bot:certainty-backtest": "tsx bot/certainty-backtest.ts",
    "bot:certainty-report": "tsx bot/certainty-report.ts",
    "bot:certainty-audit": "tsx bot/certainty-audit.ts",
    "bot:probe-book": "tsx bot/probe-clob.ts",
    "bot:test-maker": "tsx bot/maker-selftest.ts",
    "bot:test-value-exit": "tsx bot/value-exit-selftest.ts",
    "bot:test-certainty": "tsx bot/certainty-selftest.ts",
    "bot:check": "tsc -p bot/tsconfig.json"
  },
  "dependencies": {
    "@polymarket/builder-relayer-client": "^0.0.10",
    "@polymarket/clob-client-v2": "^1.0.6",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.101.2",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.46.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.3.21",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vercel": "^50.1.3",
    "vite": "^8.1.0"
  }
}
