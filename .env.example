# Server-side Polymarket credentials — NEVER use VITE_* for these.
# Local: copy to .env.local (loaded by `pnpm dev` and `pnpm dev:vercel`)
# Production: Vercel → Project → Settings → Environment Variables
# GitHub never sees these values — only this example file is committed.

# Signer EOA — the wallet that derived your CLOB API key (POLY_ADDRESS / POLY_PRIVATE_KEY)
POLY_ADDRESS=0xYourSignerAddress
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Wallet mode (CLOB V2):
#   3 = deposit wallet (recommended for new accounts) — POLY_FUNDER_ADDRESS = deposit wallet
#   1 = legacy proxy (email/Magic login) — POLY_FUNDER_ADDRESS = proxy wallet, not EOA
#   2 = Gnosis Safe — POLY_FUNDER_ADDRESS = Safe address
#   0 = bare EOA (blocked for new Polymarket accounts)
POLY_SIGNATURE_TYPE=3

# Where funds live — MUST differ from POLY_ADDRESS for types 1/2/3.
# Deposit wallet: polymarket.com/profile → View Source → search "proxyAddress"
POLY_FUNDER_ADDRESS=0xYourDepositWalletAddress

# Required on the server to place orders (never expose to the browser)
POLY_PRIVATE_KEY=

# --- Go-live security (recommended for production) ---

# Shared secret: set same value as VITE_APP_API_SECRET below.
# When set, /api/account, /api/orders, and /api/open-orders require Authorization: Bearer <secret>
APP_API_SECRET=

# Kill switch — set to false or 0 to block all trading instantly
POLY_TRADING_ENABLED=true

# Per-order limits (server-enforced)
POLY_MAX_ORDER_SIZE=1000
POLY_MAX_ORDER_COST=500

# Client-side copy of APP_API_SECRET (baked into build — personal dashboards only)
VITE_APP_API_SECRET=

# --- Local bot (bot/) — optional, local-only; see docs/bot-plan.md ---
# Token gating the bot control server's mutating endpoints (mode/halt). If unset,
# mutations are open on localhost. Set the SAME value in VITE_BOT_CONTROL_TOKEN.
BOT_CONTROL_TOKEN=
# Dashboard → bot control server. Defaults to http://127.0.0.1:8790.
VITE_BOT_CONTROL_URL=
# Client copy of BOT_CONTROL_TOKEN (or enter it in localStorage 'bot-control-token').
VITE_BOT_CONTROL_TOKEN=
#
# Strategy family: 'value' (default) = late ~T-10s edge bet held to settlement;
# 'swing' = fade a fresh odds overshoot with auto take-profit/stop mid-window.
# `pnpm bot:swing` is `BOT_STRATEGY=swing pnpm bot:paper`.
BOT_STRATEGY=value
# Rolling 24h entry cap. 0 or unset = unlimited in paper/record; live defaults to 50.
# BOT_MAX_DAILY_TRADES=0
# Swing scalp knobs (only used when BOT_STRATEGY=swing):
# Entry trigger: 'edge' (default) = trust the model, enter as soon as it disagrees
# with the market by >= BOT_SWING_EDGE_MIN (no spike needed); 'move' = only enter
# when a market spike >= BOT_SWING_MOVE_PTS confirms the edge (the stricter fade).
BOT_SWING_TRIGGER=edge
# Fair-value source for the edge: 'flat' (default) realized-vol model · 'regime'
# regime-conditional model · 'blend' regime while vol is elevated/panic else flat.
BOT_SIGNAL_SOURCE=flat
BOT_SWING_MOVE_PTS=0.04         # min mid move to count as a spike (trigger=move only)
BOT_SWING_WINDOW_SEC=20         # lookback for measuring the spike (trigger=move only)
BOT_SWING_EDGE_MIN=0.03         # min |model − market| edge to enter
BOT_SWING_TAKE_PROFIT_PTS=0.03  # exit when the mark rises this far above entry
BOT_SWING_STOP_LOSS_PTS=0.04    # exit when the mark falls this far below entry
BOT_SWING_EXIT_EDGE=0.01        # exit when the faded edge decays to/below this
BOT_SWING_TIME_STOP_SEC=20      # force-close this many seconds before settlement
BOT_SWING_COOLDOWN_SEC=30       # min gap after a close before re-entering a window
# Guardrails — keep it a mid-market scalp, not a near-expiry favorite-chase:
BOT_SWING_MIN_PRICE=0.20        # skip entries when market P(Up) is below this
BOT_SWING_MAX_PRICE=0.80        # skip entries when market P(Up) is above this
BOT_SWING_SKIP_CALM=1           # 1 = sit out the calm regime (market beats model); 0 = allow
BOT_SWING_OPEN_POLL_MS=2000     # poll cadence while holding a position (tightens the stop)
# Paper fee model (engine/fees.ts) — applied to swing trades:
BOT_FEE_RATE=0.07               # parabolic taker feeRate (crypto ≈ 0.07; 0 = off)
BOT_FEE_SELL=                   # set to 1 to also charge the fee on the sell leg
